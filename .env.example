# Copy this file to .env. Do not commit .env or .env.secrets.

# Required by backend services for event messaging.
KAFKA_BROKERS=kafka:9092

# Replace with a long, unique random secret before running the app.
JWT_SECRET=replace-with-a-long-random-secret

# Database files are stored on the host at this path.
HOST_DB_PATH=./database/dbdata

# Kafka / ZooKeeper container configuration.
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Optional: Google OAuth. Configure the matching redirect URI with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BACKEND_URL=https://localhost:8080
PUBLIC_FRONTEND_URL=https://localhost:8080

# Optional: SendGrid email for 2FA codes. Leave blank to disable email delivery.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=